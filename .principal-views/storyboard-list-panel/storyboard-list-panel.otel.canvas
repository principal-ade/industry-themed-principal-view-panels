{
  "name": "Storyboard List Panel",
  "description": "OTEL event schema for the StoryboardListPanel component - a tree view for browsing and selecting canvases and workflows",
  "markdown": ".principal-views/storyboard-list-panel/storyboard-list-panel.md",
  "nodes": [
    {
      "id": "panel-loading",
      "type": "otel-event",
      "x": 0,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#6366f1",
      "label": "Panel Loading",
      "event": {
        "name": "panel.loading",
        "attributes": {
          "panel.id": "string",
          "file.tree.sha": "string"
        }
      },
      "dataSchema": {
        "panel.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the panel instance",
          "placeholder": "storyboard-list-1"
        },
        "file.tree.sha": {
          "type": "string",
          "required": false,
          "description": "SHA hash of the file tree for cache invalidation",
          "placeholder": "abc123"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "panel-loaded",
      "type": "otel-event",
      "x": 320,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#10b981",
      "label": "Panel Loaded",
      "event": {
        "name": "panel.loaded",
        "attributes": {
          "panel.id": "string",
          "storyboard.count": "number",
          "canvas.count": "number",
          "workflow.count": "number",
          "otel.count": "number",
          "architecture.count": "number"
        }
      },
      "dataSchema": {
        "panel.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the panel instance",
          "placeholder": "storyboard-list-1"
        },
        "storyboard.count": {
          "type": "number",
          "required": true,
          "description": "Number of storyboards discovered",
          "placeholder": "5"
        },
        "canvas.count": {
          "type": "number",
          "required": true,
          "description": "Total number of canvases discovered",
          "placeholder": "12"
        },
        "workflow.count": {
          "type": "number",
          "required": false,
          "description": "Number of workflow files discovered",
          "placeholder": "3"
        },
        "otel.count": {
          "type": "number",
          "required": false,
          "description": "Count of OTEL canvases",
          "placeholder": "4"
        },
        "architecture.count": {
          "type": "number",
          "required": false,
          "description": "Count of architecture canvases (regular, scopes, spans, resources)",
          "placeholder": "8"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "panel-error",
      "type": "otel-event",
      "x": 640,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#ef4444",
      "label": "Panel Error",
      "event": {
        "name": "panel.error",
        "attributes": {
          "panel.id": "string",
          "error.type": "string",
          "error.message": "string"
        }
      },
      "dataSchema": {
        "panel.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the panel instance",
          "placeholder": "storyboard-list-1"
        },
        "error.type": {
          "type": "string",
          "required": true,
          "description": "Type of error that occurred",
          "placeholder": "DISCOVERY_FAILED"
        },
        "error.message": {
          "type": "string",
          "required": true,
          "description": "Human-readable error message",
          "placeholder": "Failed to read file tree"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "canvas-selected",
      "type": "otel-event",
      "x": 0,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#8b5cf6",
      "label": "Canvas Selected",
      "event": {
        "name": "canvas.selected",
        "attributes": {
          "canvas.id": "string",
          "canvas.name": "string",
          "canvas.path": "string",
          "canvas.type": "string"
        }
      },
      "dataSchema": {
        "canvas.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the canvas",
          "placeholder": "architecture-canvas"
        },
        "canvas.name": {
          "type": "string",
          "required": true,
          "description": "Display name of the canvas",
          "placeholder": "Architecture"
        },
        "canvas.path": {
          "type": "string",
          "required": true,
          "description": "File path to the canvas",
          "placeholder": ".principal-views/architecture.canvas"
        },
        "canvas.type": {
          "type": "string",
          "required": false,
          "description": "otel, regular, scopes, spans, or resources",
          "placeholder": "otel"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "workflow-selected",
      "type": "otel-event",
      "x": 320,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#f59e0b",
      "label": "Workflow Selected",
      "event": {
        "name": "workflow.selected",
        "attributes": {
          "workflow.id": "string",
          "workflow.name": "string",
          "workflow.path": "string",
          "canvas.id": "string",
          "scenario.count": "number"
        }
      },
      "dataSchema": {
        "workflow.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the workflow",
          "placeholder": "panel-lifecycle"
        },
        "workflow.name": {
          "type": "string",
          "required": true,
          "description": "Display name of the workflow",
          "placeholder": "Panel Lifecycle"
        },
        "workflow.path": {
          "type": "string",
          "required": true,
          "description": "File path to the workflow",
          "placeholder": ".principal-views/panel-lifecycle.workflow.json"
        },
        "canvas.id": {
          "type": "string",
          "required": true,
          "description": "ID of the associated canvas",
          "placeholder": "panel-otel-canvas"
        },
        "scenario.count": {
          "type": "number",
          "required": false,
          "description": "Number of scenarios in the workflow",
          "placeholder": "7"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "overview-selected",
      "type": "otel-event",
      "x": 640,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#06b6d4",
      "label": "Overview Selected",
      "event": {
        "name": "overview.selected",
        "attributes": {
          "canvas.id": "string",
          "markdown.path": "string"
        }
      },
      "dataSchema": {
        "canvas.id": {
          "type": "string",
          "required": true,
          "description": "ID of the canvas this overview belongs to",
          "placeholder": "architecture-canvas"
        },
        "markdown.path": {
          "type": "string",
          "required": true,
          "description": "Path to the markdown documentation file",
          "placeholder": ".principal-views/architecture.md"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "open-canvas-emitted",
      "type": "otel-event",
      "x": 0,
      "y": 320,
      "width": 280,
      "height": 120,
      "color": "#ec4899",
      "label": "Open Canvas Emitted",
      "event": {
        "name": "custom:openCanvas",
        "attributes": {
          "action": "string",
          "canvas.id": "string"
        }
      },
      "dataSchema": {
        "action": {
          "type": "string",
          "required": true,
          "description": "Always 'openCanvas'",
          "placeholder": "openCanvas"
        },
        "canvas.id": {
          "type": "string",
          "required": true,
          "description": "ID of the canvas to open",
          "placeholder": "architecture-canvas"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "open-multi-canvas-emitted",
      "type": "otel-event",
      "x": 320,
      "y": 320,
      "width": 280,
      "height": 120,
      "color": "#ec4899",
      "label": "Open Multi-Canvas Emitted",
      "event": {
        "name": "custom:openMultiCanvas",
        "attributes": {
          "action": "string",
          "canvases": "array"
        }
      },
      "dataSchema": {
        "action": {
          "type": "string",
          "required": true,
          "description": "Always 'openMultiCanvas'",
          "placeholder": "openMultiCanvas"
        },
        "canvases": {
          "type": "array",
          "required": true,
          "description": "Array of canvas objects with id, canvas, and canvasFileInfo",
          "placeholder": "[{id: '...', canvas: {...}}]"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "file-open-emitted",
      "type": "otel-event",
      "x": 640,
      "y": 320,
      "width": 280,
      "height": 120,
      "color": "#06b6d4",
      "label": "File Open Emitted",
      "event": {
        "name": "file:open",
        "attributes": {
          "path": "string"
        }
      },
      "dataSchema": {
        "path": {
          "type": "string",
          "required": true,
          "description": "File path to open (canvas, workflow, or markdown)",
          "placeholder": ".principal-views/architecture.canvas"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "refresh-requested",
      "type": "otel-event",
      "x": 0,
      "y": 480,
      "width": 280,
      "height": 120,
      "color": "#84cc16",
      "label": "Refresh Requested",
      "event": {
        "name": "canvas:refresh",
        "attributes": {
          "source": "string"
        }
      },
      "dataSchema": {
        "source": {
          "type": "string",
          "required": true,
          "description": "Always 'storyboard-list-panel'",
          "placeholder": "storyboard-list-panel"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "tab-switched",
      "type": "otel-event",
      "x": 320,
      "y": 480,
      "width": 280,
      "height": 120,
      "color": "#8b5cf6",
      "label": "Tab Switched",
      "event": {
        "name": "tab.switched",
        "attributes": {
          "tab.previous": "string",
          "tab.current": "string"
        }
      },
      "dataSchema": {
        "tab.previous": {
          "type": "string",
          "required": false,
          "description": "otel or regular",
          "placeholder": "otel"
        },
        "tab.current": {
          "type": "string",
          "required": true,
          "description": "otel or regular",
          "placeholder": "regular"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "search-changed",
      "type": "otel-event",
      "x": 640,
      "y": 480,
      "width": 280,
      "height": 120,
      "color": "#64748b",
      "label": "Search Changed",
      "event": {
        "name": "search.changed",
        "attributes": {
          "search.query": "string",
          "result.count": "number"
        }
      },
      "dataSchema": {
        "search.query": {
          "type": "string",
          "required": true,
          "description": "The search query entered by the user",
          "placeholder": "architecture"
        },
        "result.count": {
          "type": "number",
          "required": false,
          "description": "Number of matching storyboards after filtering",
          "placeholder": "3"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "node-toggled",
      "type": "otel-event",
      "x": 0,
      "y": 640,
      "width": 280,
      "height": 120,
      "color": "#0ea5e9",
      "label": "Node Toggled",
      "event": {
        "name": "node.toggled",
        "attributes": {
          "node.id": "string",
          "node.open": "boolean"
        }
      },
      "dataSchema": {
        "node.id": {
          "type": "string",
          "required": true,
          "description": "ID of the toggled tree node",
          "placeholder": "storyboard:my-storyboard"
        },
        "node.open": {
          "type": "boolean",
          "required": true,
          "description": "True if expanded, false if collapsed",
          "placeholder": "true"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "select-node-received",
      "type": "otel-event",
      "x": 320,
      "y": 640,
      "width": 280,
      "height": 120,
      "color": "#a855f7",
      "label": "Select Node Received",
      "event": {
        "name": "custom:selectNode",
        "attributes": {
          "action": "string",
          "node.id": "string"
        }
      },
      "dataSchema": {
        "action": {
          "type": "string",
          "required": true,
          "description": "Always 'selectNode'",
          "placeholder": "selectNode"
        },
        "node.id": {
          "type": "string",
          "required": true,
          "description": "Node ID format: 'canvas:id', 'workflow:id', 'overview:id', 'storyboard:id'",
          "placeholder": "canvas:architecture"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "toggle-node-received",
      "type": "otel-event",
      "x": 640,
      "y": 640,
      "width": 280,
      "height": 120,
      "color": "#a855f7",
      "label": "Toggle Node Received",
      "event": {
        "name": "custom:toggleNode",
        "attributes": {
          "action": "string",
          "node.id": "string",
          "open": "boolean"
        }
      },
      "dataSchema": {
        "action": {
          "type": "string",
          "required": true,
          "description": "Always 'toggleNode'",
          "placeholder": "toggleNode"
        },
        "node.id": {
          "type": "string",
          "required": true,
          "description": "ID of the node to toggle",
          "placeholder": "storyboard:my-storyboard"
        },
        "open": {
          "type": "boolean",
          "required": false,
          "description": "If provided, sets state; if omitted, toggles current state",
          "placeholder": "true"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "context-menu-opened",
      "type": "otel-event",
      "x": 0,
      "y": 800,
      "width": 280,
      "height": 120,
      "color": "#64748b",
      "label": "Context Menu Opened",
      "event": {
        "name": "context.menu.opened",
        "attributes": {
          "node.id": "string",
          "node.type": "string",
          "position.x": "number",
          "position.y": "number"
        }
      },
      "dataSchema": {
        "node.id": {
          "type": "string",
          "required": true,
          "description": "ID of the right-clicked node",
          "placeholder": "canvas:architecture"
        },
        "node.type": {
          "type": "string",
          "required": true,
          "description": "canvas, workflow, overview, or storyboard",
          "placeholder": "canvas"
        },
        "position.x": {
          "type": "number",
          "required": true,
          "description": "X coordinate of the context menu",
          "placeholder": "150"
        },
        "position.y": {
          "type": "number",
          "required": true,
          "description": "Y coordinate of the context menu",
          "placeholder": "200"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    },
    {
      "id": "path-copied",
      "type": "otel-event",
      "x": 320,
      "y": 800,
      "width": 280,
      "height": 120,
      "color": "#10b981",
      "label": "Path Copied",
      "event": {
        "name": "path.copied",
        "attributes": {
          "path": "string",
          "node.type": "string"
        }
      },
      "dataSchema": {
        "path": {
          "type": "string",
          "required": true,
          "description": "The file path that was copied",
          "placeholder": ".principal-views/architecture.canvas"
        },
        "node.type": {
          "type": "string",
          "required": true,
          "description": "Type of the node whose path was copied",
          "placeholder": "canvas"
        }
      },
      "otel": {
        "scope": "storyboard-list-panel",
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-loading-loaded",
      "fromNode": "panel-loading",
      "toNode": "panel-loaded",
      "fromSide": "right",
      "toSide": "left",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-loading-error",
      "fromNode": "panel-loading",
      "toNode": "panel-error",
      "fromSide": "right",
      "toSide": "left",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-loaded-canvas",
      "fromNode": "panel-loaded",
      "toNode": "canvas-selected",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-loaded-workflow",
      "fromNode": "panel-loaded",
      "toNode": "workflow-selected",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-loaded-overview",
      "fromNode": "panel-loaded",
      "toNode": "overview-selected",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-canvas-open",
      "fromNode": "canvas-selected",
      "toNode": "open-canvas-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "emits"
    },
    {
      "id": "edge-workflow-open",
      "fromNode": "workflow-selected",
      "toNode": "open-canvas-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "emits"
    },
    {
      "id": "edge-overview-file",
      "fromNode": "overview-selected",
      "toNode": "file-open-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "emits"
    },
    {
      "id": "edge-loaded-multi",
      "fromNode": "panel-loaded",
      "toNode": "open-multi-canvas-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-refresh-loading",
      "fromNode": "refresh-requested",
      "toNode": "panel-loading",
      "fromSide": "top",
      "toSide": "bottom",
      "edgeType": "triggers"
    },
    {
      "id": "edge-loaded-tab",
      "fromNode": "panel-loaded",
      "toNode": "tab-switched",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-loaded-search",
      "fromNode": "panel-loaded",
      "toNode": "search-changed",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-loaded-toggle",
      "fromNode": "panel-loaded",
      "toNode": "node-toggled",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "data-flow"
    },
    {
      "id": "edge-select-received",
      "fromNode": "select-node-received",
      "toNode": "canvas-selected",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "triggers"
    },
    {
      "id": "edge-toggle-received",
      "fromNode": "toggle-node-received",
      "toNode": "node-toggled",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "triggers"
    },
    {
      "id": "edge-context-copy",
      "fromNode": "context-menu-opened",
      "toNode": "path-copied",
      "fromSide": "right",
      "toSide": "left",
      "edgeType": "data-flow"
    }
  ]
}
