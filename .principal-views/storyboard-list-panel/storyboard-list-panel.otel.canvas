      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-canvas-open",
      "fromNode": "canvas-selected",
      "toNode": "open-canvas-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-workflow-open",
      "fromNode": "workflow-selected",
      "toNode": "open-canvas-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-overview-file",
      "fromNode": "overview-selected",
      "toNode": "file-open-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
