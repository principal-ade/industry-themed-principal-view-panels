      "toNode": "open-multi-canvas-emitted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-refresh-loading",
      "fromNode": "refresh-requested",
      "toNode": "panel-loading",
      "fromSide": "top",
      "toSide": "bottom",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-loaded-tab",
      "fromNode": "panel-loaded",
      "toNode": "tab-switched",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-loaded-search",
      "fromNode": "panel-loaded",
      "toNode": "search-changed",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-loaded-toggle",
      "fromNode": "panel-loaded",
      "toNode": "node-toggled",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-select-received",
      "fromNode": "select-node-received",
      "toNode": "canvas-selected",
      "fromSide": "left",
      "toSide": "right",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-toggle-received",
      "fromNode": "toggle-node-received",
      "toNode": "node-toggled",
      "fromSide": "left",
      "toSide": "right",
      "pv": {
        "edgeType": "triggers"
