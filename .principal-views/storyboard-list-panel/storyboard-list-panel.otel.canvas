    },
    {
      "id": "edge-context-copy",
      "fromNode": "context-menu-opened",
      "toNode": "path-copied",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "data-flow"
      }
    }
  ],
  "pv": {
    "name": "Storyboard List Panel",
    "version": "1.0.0",
    "description": "OTEL event schema for the StoryboardListPanel component - a tree view for browsing and selecting canvases and workflows",
    "markdown": ".principal-views/storyboard-list-panel/storyboard-list-panel.md"
  }
}
