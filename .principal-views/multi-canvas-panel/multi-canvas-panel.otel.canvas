        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "interaction"
        },
        "dataSchema": {
          "node.id": {
            "type": "string",
            "required": true
          },
          "canvas.id": {
            "type": "string",
            "required": false
          }
        }
      }
    },
    {
      "id": "empty-state",
      "type": "text",
      "text": "# Empty State\n\nNo canvases loaded successfully",
      "x": 1150,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#64748b",
      "pv": {
        "event": {
          "name": "panel.empty",
