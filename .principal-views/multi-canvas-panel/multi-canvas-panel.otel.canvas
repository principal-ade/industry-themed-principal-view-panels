        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "ui-state"
        }
      }
    },
    {
      "id": "vertical-layout",
      "type": "text",
      "text": "# Vertical Layout\n\nCanvases stacked top to bottom",
      "x": 380,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#a855f7",
      "pv": {
        "event": {
          "name": "layout.vertical",
