{
  "nodes": [
    {
      "id": "props-received",
      "type": "otel-event",
      "x": 0,
      "y": 0,
      "width": 300,
      "height": 100,
      "color": "#6366f1",
      "label": "Props Received",
      "event": {
        "name": "panel.props.received",
        "attributes": {
          "mode": "string",
          "canvas.count": "number"
        }
      },
      "dataSchema": {
        "mode": {
          "type": "string",
          "required": true,
          "description": "Operation mode of the panel",
          "placeholder": "static"
        },
        "canvas.count": {
          "type": "number",
          "required": true,
          "description": "Number of canvases to display",
          "placeholder": "3",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "static-mode",
      "type": "otel-event",
      "x": 400,
      "y": -100,
      "width": 300,
      "height": 120,
      "color": "#10b981",
      "label": "Static Layout Mode",
      "event": {
        "name": "panel.mode.static",
        "attributes": {
          "placement.count": "number"
        }
      },
      "dataSchema": {
        "placement.count": {
          "type": "number",
          "required": true,
          "description": "Number of canvas placements in the layout",
          "placeholder": "4"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "dynamic-mode",
      "type": "otel-event",
      "x": 400,
      "y": 100,
      "width": 300,
      "height": 120,
      "color": "#f59e0b",
      "label": "Dynamic Loading Mode",
      "event": {
        "name": "panel.mode.dynamic",
        "attributes": {
          "canvas.paths": "string[]"
        }
      },
      "dataSchema": {
        "canvas.paths": {
          "type": "array",
          "required": true,
          "description": "Paths to canvas files to load",
          "placeholder": "[\"canvas1.canvas\", \"canvas2.canvas\"]"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "loading-started",
      "type": "otel-event",
      "x": 800,
      "y": 100,
      "width": 280,
      "height": 100,
      "color": "#8b5cf6",
      "label": "Loading Started",
      "event": {
        "name": "canvas.loading.started",
        "attributes": {
          "canvas.count": "number",
          "repository.path": "string"
        }
      },
      "dataSchema": {
        "canvas.count": {
          "type": "number",
          "required": true,
          "description": "Number of canvases being loaded",
          "placeholder": "3"
        },
        "repository.path": {
          "type": "string",
          "required": true,
          "description": "Root path of the repository",
          "placeholder": "/path/to/repo"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "file-read",
      "type": "otel-event",
      "x": 1150,
      "y": 0,
      "width": 280,
      "height": 100,
      "color": "#06b6d4",
      "label": "File Read",
      "event": {
        "name": "canvas.file.read",
        "attributes": {
          "file.path": "string",
          "file.size": "number"
        }
      },
      "dataSchema": {
        "file.path": {
          "type": "string",
          "required": true,
          "description": "Path to the canvas file being read",
          "placeholder": "architecture.canvas"
        },
        "file.size": {
          "type": "number",
          "required": false,
          "description": "Size of the file in bytes",
          "placeholder": "4096",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "canvas-parsed",
      "type": "otel-event",
      "x": 1150,
      "y": 140,
      "width": 280,
      "height": 120,
      "color": "#06b6d4",
      "label": "Canvas Parsed",
      "event": {
        "name": "canvas.parsed",
        "attributes": {
          "canvas.id": "string",
          "node.count": "number",
          "edge.count": "number"
        }
      },
      "dataSchema": {
        "canvas.id": {
          "type": "string",
          "required": true,
          "description": "Identifier of the parsed canvas",
          "placeholder": "my-canvas"
        },
        "node.count": {
          "type": "number",
          "required": true,
          "description": "Number of nodes in the canvas",
          "placeholder": "12"
        },
        "edge.count": {
          "type": "number",
          "required": false,
          "description": "Number of edges in the canvas",
          "placeholder": "8",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "loading-complete",
      "type": "otel-event",
      "x": 800,
      "y": 300,
      "width": 280,
      "height": 100,
      "color": "#10b981",
      "label": "Loading Complete",
      "event": {
        "name": "canvas.loading.complete",
        "attributes": {
          "canvas.loaded.count": "number",
          "canvas.failed.count": "number"
        }
      },
      "dataSchema": {
        "canvas.loaded.count": {
          "type": "number",
          "required": true,
          "description": "Number of canvases successfully loaded",
          "placeholder": "3"
        },
        "canvas.failed.count": {
          "type": "number",
          "required": false,
          "description": "Number of canvases that failed to load",
          "placeholder": "0"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "loading-error",
      "type": "otel-event",
      "x": 1150,
      "y": 300,
      "width": 280,
      "height": 120,
      "color": "#ef4444",
      "label": "Loading Error",
      "event": {
        "name": "canvas.loading.error",
        "attributes": {
          "error.type": "string",
          "error.message": "string"
        }
      },
      "dataSchema": {
        "error.type": {
          "type": "string",
          "required": true,
          "description": "Type of error that occurred",
          "placeholder": "FILE_NOT_FOUND"
        },
        "error.message": {
          "type": "string",
          "required": true,
          "description": "Human-readable error message",
          "placeholder": "Canvas file not found"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "layout-created",
      "type": "otel-event",
      "x": 400,
      "y": 300,
      "width": 280,
      "height": 120,
      "color": "#84cc16",
      "label": "Layout Created",
      "event": {
        "name": "layout.created",
        "attributes": {
          "direction": "string",
          "gap": "number",
          "columns": "number",
          "placement.count": "number"
        }
      },
      "dataSchema": {
        "direction": {
          "type": "string",
          "required": true,
          "description": "Layout direction: grid, vertical, or horizontal",
          "placeholder": "grid"
        },
        "gap": {
          "type": "number",
          "required": true,
          "description": "Gap between canvases in pixels",
          "placeholder": "20",
          "displayInLabel": false
        },
        "columns": {
          "type": "number",
          "required": false,
          "description": "Number of columns for grid layout",
          "placeholder": "2",
          "displayInLabel": false
        },
        "placement.count": {
          "type": "number",
          "required": true,
          "description": "Total number of canvas placements",
          "placeholder": "4"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "grid-layout",
      "type": "otel-event",
      "x": 100,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#ec4899",
      "label": "Grid Layout",
      "event": {
        "name": "layout.grid",
        "attributes": {
          "cell.width": "number",
          "cell.height": "number",
          "columns": "number"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "vertical-layout",
      "type": "otel-event",
      "x": 380,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#a855f7",
      "label": "Vertical Layout",
      "event": {
        "name": "layout.vertical",
        "attributes": {
          "total.height": "number"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "horizontal-layout",
      "type": "otel-event",
      "x": 660,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#0ea5e9",
      "label": "Horizontal Layout",
      "event": {
        "name": "layout.horizontal",
        "attributes": {
          "total.width": "number"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "renderer-mounted",
      "type": "otel-event",
      "x": 400,
      "y": 640,
      "width": 300,
      "height": 120,
      "color": "#10b981",
      "label": "Renderer Mounted",
      "event": {
        "name": "renderer.mounted",
        "attributes": {
          "show.groups": "boolean",
          "show.minimap": "boolean",
          "show.controls": "boolean",
          "show.background": "boolean",
          "background.variant": "string"
        }
      },
      "dataSchema": {
        "show.groups": {
          "type": "boolean",
          "required": true,
          "description": "Whether to show group nodes",
          "placeholder": "true",
          "displayInLabel": false
        },
        "show.minimap": {
          "type": "boolean",
          "required": true,
          "description": "Whether to show the minimap",
          "placeholder": "true"
        },
        "show.controls": {
          "type": "boolean",
          "required": true,
          "description": "Whether to show zoom/pan controls",
          "placeholder": "true",
          "displayInLabel": false
        },
        "show.background": {
          "type": "boolean",
          "required": true,
          "description": "Whether to show background pattern",
          "placeholder": "true"
        },
        "background.variant": {
          "type": "string",
          "required": false,
          "description": "Background pattern variant: dots, lines, cross",
          "placeholder": "dots",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "node-clicked",
      "type": "otel-event",
      "x": 800,
      "y": 640,
      "width": 280,
      "height": 100,
      "color": "#f59e0b",
      "label": "Node Clicked",
      "event": {
        "name": "node.clicked",
        "attributes": {
          "node.id": "string",
          "canvas.id": "string"
        }
      },
      "dataSchema": {
        "node.id": {
          "type": "string",
          "required": true,
          "description": "ID of the clicked node",
          "placeholder": "node-1"
        },
        "canvas.id": {
          "type": "string",
          "required": false,
          "description": "ID of the canvas containing the node",
          "placeholder": "canvas-1"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "empty-state",
      "type": "otel-event",
      "x": 1150,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#64748b",
      "label": "Empty State",
      "event": {
        "name": "panel.empty",
        "attributes": {
          "reason": "string"
        }
      },
      "dataSchema": {
        "reason": {
          "type": "string",
          "required": true,
          "description": "Reason for the empty state",
          "placeholder": "No canvases loaded"
        }
      },
      "otel": {
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-props-static",
      "fromNode": "props-received",
      "toNode": "static-mode",
      "fromSide": "right",
      "toSide": "left",
      "label": "layout prop",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-props-dynamic",
      "fromNode": "props-received",
      "toNode": "dynamic-mode",
      "fromSide": "right",
      "toSide": "left",
      "label": "canvasInfos prop",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-static-render",
      "fromNode": "static-mode",
      "toNode": "renderer-mounted",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "direct render",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-dynamic-loading",
      "fromNode": "dynamic-mode",
      "toNode": "loading-started",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-loading-read",
      "fromNode": "loading-started",
      "toNode": "file-read",
      "fromSide": "right",
      "toSide": "left",
      "label": "for each canvas",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-read-parse",
      "fromNode": "file-read",
      "toNode": "canvas-parsed",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-parse-complete",
      "fromNode": "canvas-parsed",
      "toNode": "loading-complete",
      "fromSide": "bottom",
      "toSide": "right",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-loading-error",
      "fromNode": "loading-started",
      "toNode": "loading-error",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "on error",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-complete-layout",
      "fromNode": "loading-complete",
      "toNode": "layout-created",
      "fromSide": "left",
      "toSide": "right",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-layout-grid",
      "fromNode": "layout-created",
      "toNode": "grid-layout",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "direction=grid",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-layout-vertical",
      "fromNode": "layout-created",
      "toNode": "vertical-layout",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "direction=vertical",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-layout-horizontal",
      "fromNode": "layout-created",
      "toNode": "horizontal-layout",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "direction=horizontal",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-grid-render",
      "fromNode": "grid-layout",
      "toNode": "renderer-mounted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-vertical-render",
      "fromNode": "vertical-layout",
      "toNode": "renderer-mounted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-horizontal-render",
      "fromNode": "horizontal-layout",
      "toNode": "renderer-mounted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-render-click",
      "fromNode": "renderer-mounted",
      "toNode": "node-clicked",
      "fromSide": "right",
      "toSide": "left",
      "label": "onNodeClick",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-complete-empty",
      "fromNode": "loading-complete",
      "toNode": "empty-state",
      "fromSide": "right",
      "toSide": "left",
      "label": "0 loaded",
      "pv": {
        "edgeType": "data-flow"
      }
    }
  ],
  "pv": {
    "name": "Multi Canvas Panel",
    "version": "1.0.0",
    "description": "OTEL event schema for the MultiCanvasPanel component - displays multiple canvases on a unified view",
    "markdown": ".principal-views/multi-canvas-panel/multi-canvas-panel.md"
  }
}
