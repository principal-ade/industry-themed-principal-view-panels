{
  "nodes": [
    {
      "id": "props-received",
      "type": "text",
      "text": "# Props Received\n\nMultiCanvasPanel receives props and determines operation mode",
      "x": 0,
      "y": 0,
      "width": 300,
      "height": 100,
      "color": "#6366f1",
      "pv": {
        "event": {
          "name": "panel.props.received",
          "attributes": {
            "mode": "string",
            "canvas.count": "number"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "mode": {
            "type": "string",
            "required": true
          },
          "canvas.count": {
            "type": "number",
            "required": true
          }
        }
      }
    },
    {
      "id": "static-mode",
      "type": "text",
      "text": "# Static Layout Mode\n\nLayout prop provided directly with pre-built canvas data (used in Storybook)",
      "x": 400,
      "y": -100,
      "width": 300,
      "height": 120,
      "color": "#10b981",
      "pv": {
        "event": {
          "name": "panel.mode.static",
          "attributes": {
            "placement.count": "number"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "placement.count": {
            "type": "number",
            "required": true
          }
        }
      }
    },
    {
      "id": "dynamic-mode",
      "type": "text",
      "text": "# Dynamic Loading Mode\n\ncanvasInfos prop with paths to load from files (production use)",
      "x": 400,
      "y": 100,
      "width": 300,
      "height": 120,
      "color": "#f59e0b",
      "pv": {
        "event": {
          "name": "panel.mode.dynamic",
          "attributes": {
            "canvas.paths": "string[]"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "canvas.paths": {
            "type": "array",
            "required": true
          }
        }
      }
    },
    {
      "id": "loading-started",
      "type": "text",
      "text": "# Loading Started\n\nBegins loading canvas files from repository",
      "x": 800,
      "y": 100,
      "width": 280,
      "height": 100,
      "color": "#8b5cf6",
      "pv": {
        "event": {
          "name": "canvas.loading.started",
          "attributes": {
            "canvas.count": "number",
            "repository.path": "string"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "canvas.count": {
            "type": "number",
            "required": true
          },
          "repository.path": {
            "type": "string",
            "required": true
          }
        }
      }
    },
    {
      "id": "file-read",
      "type": "text",
      "text": "# File Read\n\nReads canvas file using actions.readFile",
      "x": 1150,
      "y": 0,
      "width": 280,
      "height": 100,
      "color": "#06b6d4",
      "pv": {
        "event": {
          "name": "canvas.file.read",
          "attributes": {
            "file.path": "string",
            "file.size": "number"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "io"
        },
        "dataSchema": {
          "file.path": {
            "type": "string",
            "required": true
          },
          "file.size": {
            "type": "number",
            "required": false
          }
        }
      }
    },
    {
      "id": "canvas-parsed",
      "type": "text",
      "text": "# Canvas Parsed\n\nConfigLoader.parseCanvas extracts ExtendedCanvas from file content",
      "x": 1150,
      "y": 140,
      "width": 280,
      "height": 120,
      "color": "#06b6d4",
      "pv": {
        "event": {
          "name": "canvas.parsed",
          "attributes": {
            "canvas.id": "string",
            "node.count": "number",
            "edge.count": "number"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "canvas.id": {
            "type": "string",
            "required": true
          },
          "node.count": {
            "type": "number",
            "required": true
          },
          "edge.count": {
            "type": "number",
            "required": false
          }
        }
      }
    },
    {
      "id": "loading-complete",
      "type": "text",
      "text": "# Loading Complete\n\nAll canvases loaded successfully",
      "x": 800,
      "y": 300,
      "width": 280,
      "height": 100,
      "color": "#10b981",
      "pv": {
        "event": {
          "name": "canvas.loading.complete",
          "attributes": {
            "canvas.loaded.count": "number",
            "canvas.failed.count": "number"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "canvas.loaded.count": {
            "type": "number",
            "required": true
          },
          "canvas.failed.count": {
            "type": "number",
            "required": false
          }
        }
      }
    },
    {
      "id": "loading-error",
      "type": "text",
      "text": "# Loading Error\n\nCritical error during loading (missing readFile or repositoryPath)",
      "x": 1150,
      "y": 300,
      "width": 280,
      "height": 120,
      "color": "#ef4444",
      "pv": {
        "event": {
          "name": "canvas.loading.error",
          "attributes": {
            "error.type": "string",
            "error.message": "string"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "error"
        },
        "dataSchema": {
          "error.type": {
            "type": "string",
            "required": true
          },
          "error.message": {
            "type": "string",
            "required": true
          }
        }
      }
    },
    {
      "id": "layout-created",
      "type": "text",
      "text": "# Layout Created\n\ncreateMultiCanvasLayout generates placements with positions",
      "x": 400,
      "y": 300,
      "width": 280,
      "height": 120,
      "color": "#84cc16",
      "pv": {
        "event": {
          "name": "layout.created",
          "attributes": {
            "direction": "string",
            "gap": "number",
            "columns": "number",
            "placement.count": "number"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "direction": {
            "type": "string",
            "required": true
          },
          "gap": {
            "type": "number",
            "required": true
          },
          "columns": {
            "type": "number",
            "required": false
          },
          "placement.count": {
            "type": "number",
            "required": true
          }
        }
      }
    },
    {
      "id": "grid-layout",
      "type": "text",
      "text": "# Grid Layout\n\n2-column grid with uniform cell sizing",
      "x": 100,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#ec4899",
      "pv": {
        "event": {
          "name": "layout.grid",
          "attributes": {
            "cell.width": "number",
            "cell.height": "number",
            "columns": "number"
          }
