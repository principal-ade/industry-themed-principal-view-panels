  ],
  "edges": [
    {
      "id": "edge-props-static",
      "fromNode": "props-received",
      "toNode": "static-mode",
      "fromSide": "right",
      "toSide": "left",
      "label": "layout prop",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-props-dynamic",
      "fromNode": "props-received",
      "toNode": "dynamic-mode",
      "fromSide": "right",
      "toSide": "left",
      "label": "canvasInfos prop",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-static-render",
      "fromNode": "static-mode",
      "toNode": "renderer-mounted",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "direct render",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-dynamic-loading",
      "fromNode": "dynamic-mode",
      "toNode": "loading-started",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-loading-read",
      "fromNode": "loading-started",
      "toNode": "file-read",
