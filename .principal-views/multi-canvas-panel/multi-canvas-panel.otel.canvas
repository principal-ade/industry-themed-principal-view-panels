        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "ui-state"
        }
      }
    },
    {
      "id": "horizontal-layout",
      "type": "text",
      "text": "# Horizontal Layout\n\nCanvases side by side",
      "x": 660,
      "y": 480,
      "width": 240,
      "height": 100,
      "color": "#0ea5e9",
      "pv": {
        "event": {
          "name": "layout.horizontal",
          "attributes": {
            "total.width": "number"
          }
