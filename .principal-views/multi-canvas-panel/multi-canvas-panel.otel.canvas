        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "ui-state"
        }
      }
    },
    {
      "id": "renderer-mounted",
      "type": "text",
      "text": "# Renderer Mounted\n\nMultiCanvasRenderer displays unified view with all canvases",
      "x": 400,
      "y": 640,
      "width": 300,
      "height": 120,
      "color": "#10b981",
      "pv": {
        "event": {
          "name": "renderer.mounted",
          "attributes": {
            "show.groups": "boolean",
            "show.minimap": "boolean",
            "show.controls": "boolean",
            "show.background": "boolean",
            "background.variant": "string"
          }
        },
        "references": ["src/panels/MultiCanvasPanel.tsx"],
        "status": "draft",
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "dataSchema": {
          "show.groups": {
            "type": "boolean",
            "required": true
          },
          "show.minimap": {
            "type": "boolean",
            "required": true
          },
          "show.controls": {
            "type": "boolean",
            "required": true
          },
          "show.background": {
            "type": "boolean",
            "required": true
          },
          "background.variant": {
            "type": "string",
            "required": false
          }
        }
      }
    },
    {
      "id": "node-clicked",
      "type": "text",
      "text": "# Node Clicked\n\nUser clicks a node in one of the canvases",
      "x": 800,
      "y": 640,
      "width": 280,
      "height": 100,
      "color": "#f59e0b",
      "pv": {
        "event": {
          "name": "node.clicked",
          "attributes": {
