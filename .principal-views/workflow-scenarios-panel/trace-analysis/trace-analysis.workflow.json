{
  "version": "1.0.0",
  "canvas": ".principal-views/workflow-scenarios-panel/workflow-scenarios-panel.otel.canvas",
  "name": "Trace Analysis",
  "description": "Detailed analysis of trace executions including event inspection and canvas navigation",
  "spanPattern": "workflow-scenarios-panel.trace-analysis",
  "scenarioSelection": "first-match",
  "status": "draft",
  "scenarios": [
    {
      "id": "full-match-analysis",
      "priority": 1,
      "description": "Analyzing a trace that fully matches a scenario with event inspection",
      "template": {
        "events": {
          "trace.selected": "Selected trace {{trace.id}} from {{trace.source}} ({{span.count}} spans, scenario={{scenario.id}})",
          "trace.loaded": "Full match on trace {{trace.id}}: {{span.count}} spans, {{event.count}} events (match={{match.type}}, coverage={{coverage.percent}}%)",
          "event.clicked": "Inspecting event {{event.name}} at index {{event.index}} (span={{span.index}})",
          "node.clicked": "Highlighting node {{node.id}} on canvas (event={{node.event}}, shift={{modifier.shift}})"
        },
        "summary": "Analyzed fully matched trace with {{event.count}} events"
      }
    },
    {
      "id": "view-mode-exploration",
      "priority": 2,
      "description": "User switches between different view modes to analyze trace",
      "template": {
        "events": {
          "trace.selected": "Selected trace {{trace.id}} ({{span.count}} spans, scenario={{scenario.id}})",
          "trace.loaded": "Loaded trace {{trace.id}} with {{span.count}} spans (match={{match.type}}, coverage={{coverage.percent}}%)",
          "view.mode.changed": "Switched view: {{mode.previous}} to {{mode.current}}"
        },
        "summary": "Explored trace using {{mode.current}} view"
      }
    },
    {
      "id": "playback-analysis",
      "priority": 3,
      "description": "User plays back trace to analyze execution flow",
      "template": {
        "events": {
          "trace.selected": "Selected trace {{trace.id}} ({{span.count}} spans, scenario={{scenario.id}})",
          "trace.loaded": "Loaded trace {{trace.id}}: {{span.count}} spans with {{event.count}} events (match={{match.type}}, coverage={{coverage.percent}}%)",
          "playback.started": "Started playback at span {{span.index}} (trace={{trace.id}}, event={{event.index}})",
          "playback.stopped": "Playback {{reason}} (trace={{trace.id}}, span={{span.index}}, event={{event.index}})"
        },
        "summary": "Analyzed trace via playback"
      }
    }
  ]
}
