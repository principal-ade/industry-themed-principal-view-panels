            "displayInLabel": false
          }
        }
      }
    },
    {
      "id": "trace-loaded",
      "type": "text",
      "text": "# Trace Loaded\n\nEmitted when trace execution data is loaded and rendered",
      "x": 640,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#10b981",
      "pv": {
        "event": {
          "name": "trace.loaded",
          "attributes": {
            "trace.id": "string",
            "span.count": "number",
            "event.count": "number",
            "match.type": "string",
            "coverage.percent": "number"
          }
        },
        "references": ["src/panels/WorkflowScenariosPanel.tsx"],
        "status": "draft",
        "nodeType": "event",
        "dataSchema": {
          "trace.id": {
            "type": "string",
            "required": true,
            "description": "ID of the loaded trace",
            "placeholder": "trace-123",
            "displayInLabel": false
          },
          "span.count": {
            "type": "number",
            "required": true,
            "description": "Number of spans in the trace",
            "placeholder": "5"
          },
          "event.count": {
            "type": "number",
            "required": true,
            "description": "Number of events in the trace",
            "placeholder": "12"
          },
          "match.type": {
            "type": "string",
            "required": false,
            "description": "Type of scenario match: full, partial, none",
