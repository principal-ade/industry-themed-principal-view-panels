{
  "nodes": [
    {
      "id": "panel-loading",
      "type": "text",
      "text": "# Panel Loading\n\nEmitted when the panel begins loading canvas and workflow data",
      "x": 0,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#6366f1",
      "pv": {
        "event": {
          "name": "panel.loading",
          "attributes": {
            "panel.id": "string",
            "canvas.id": "string",
            "workflow.id": "string"
          }
        },
        "references": ["src/panels/WorkflowScenariosPanel.tsx"],
        "status": "draft",
        "nodeType": "event",
        "dataSchema": {
          "panel.id": {
            "type": "string",
            "required": true,
            "description": "Unique identifier for the panel instance",
            "placeholder": "workflow-panel-1"
          },
          "canvas.id": {
            "type": "string",
            "required": false,
            "description": "ID of the canvas being loaded",
            "placeholder": "my-otel-canvas"
          },
          "workflow.id": {
            "type": "string",
            "required": false,
            "description": "ID of the workflow being loaded",
            "placeholder": "panel-lifecycle"
          }
        }
      }
    },
    {
      "id": "panel-loaded",
      "type": "text",
      "text": "# Panel Loaded\n\nEmitted when canvas and workflow are successfully loaded",
      "x": 320,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#10b981",
      "pv": {
        "event": {
          "name": "panel.loaded",
          "attributes": {
            "panel.id": "string",
            "canvas.name": "string",
            "workflow.name": "string",
            "scenario.count": "number",
            "trace.count": "number"
          }
        },
        "references": ["src/panels/WorkflowScenariosPanel.tsx"],
        "status": "draft",
        "nodeType": "event",
        "dataSchema": {
          "panel.id": {
            "type": "string",
            "required": true,
            "description": "Unique identifier for the panel instance",
            "placeholder": "workflow-panel-1"
          },
          "canvas.name": {
            "type": "string",
            "required": true,
            "description": "Display name of the canvas",
            "placeholder": "Panel Lifecycle Canvas"
          },
          "workflow.name": {
            "type": "string",
            "required": false,
            "description": "Display name of the workflow",
            "placeholder": "Panel Lifecycle"
          },
          "scenario.count": {
            "type": "number",
            "required": false,
            "description": "Number of scenarios in the workflow",
            "placeholder": "7"
          },
          "trace.count": {
            "type": "number",
            "required": false,
            "description": "Number of traces available",
            "placeholder": "12"
          }
        }
      }
    },
    {
      "id": "panel-error",
      "type": "text",
      "text": "# Panel Error\n\nEmitted when loading fails",
      "x": 640,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#ef4444",
      "pv": {
        "event": {
          "name": "panel.error",
          "attributes": {
            "panel.id": "string",
            "error.type": "string",
            "error.message": "string"
          }
        },
        "references": ["src/panels/WorkflowScenariosPanel.tsx"],
        "status": "draft",
        "nodeType": "event",
        "dataSchema": {
          "panel.id": {
            "type": "string",
            "required": true,
            "description": "Unique identifier for the panel instance",
            "placeholder": "workflow-panel-1"
          },
          "error.type": {
            "type": "string",
            "required": true,
            "description": "Type of error that occurred",
            "placeholder": "CANVAS_NOT_FOUND"
          },
          "error.message": {
            "type": "string",
            "required": true,
            "description": "Human-readable error message",
            "placeholder": "Canvas file not found"
          }
        }
      }
    },
    {
