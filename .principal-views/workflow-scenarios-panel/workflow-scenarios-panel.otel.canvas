{
  "nodes": [
    {
      "id": "panel-loading",
      "type": "otel-event",
      "x": 0,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#6366f1",
      "label": "Panel Loading",
      "event": {
        "name": "panel.loading",
        "attributes": {
          "panel.id": "string",
          "canvas.id": "string",
          "workflow.id": "string"
        }
      },
      "dataSchema": {
        "panel.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the panel instance",
          "placeholder": "workflow-panel-1"
        },
        "canvas.id": {
          "type": "string",
          "required": false,
          "description": "ID of the canvas being loaded",
          "placeholder": "my-otel-canvas"
        },
        "workflow.id": {
          "type": "string",
          "required": false,
          "description": "ID of the workflow being loaded",
          "placeholder": "panel-lifecycle"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "panel-loaded",
      "type": "otel-event",
      "x": 320,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#10b981",
      "label": "Panel Loaded",
      "event": {
        "name": "panel.loaded",
        "attributes": {
          "panel.id": "string",
          "canvas.name": "string",
          "workflow.name": "string",
          "scenario.count": "number",
          "trace.count": "number"
        }
      },
      "dataSchema": {
        "panel.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the panel instance",
          "placeholder": "workflow-panel-1"
        },
        "canvas.name": {
          "type": "string",
          "required": true,
          "description": "Display name of the canvas",
          "placeholder": "Panel Lifecycle Canvas"
        },
        "workflow.name": {
          "type": "string",
          "required": false,
          "description": "Display name of the workflow",
          "placeholder": "Panel Lifecycle"
        },
        "scenario.count": {
          "type": "number",
          "required": false,
          "description": "Number of scenarios in the workflow",
          "placeholder": "7"
        },
        "trace.count": {
          "type": "number",
          "required": false,
          "description": "Number of traces available",
          "placeholder": "12"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "panel-error",
      "type": "otel-event",
      "x": 640,
      "y": 0,
      "width": 280,
      "height": 120,
      "color": "#ef4444",
      "label": "Panel Error",
      "event": {
        "name": "panel.error",
        "attributes": {
          "panel.id": "string",
          "error.type": "string",
          "error.message": "string"
        }
      },
      "dataSchema": {
        "panel.id": {
          "type": "string",
          "required": true,
          "description": "Unique identifier for the panel instance",
          "placeholder": "workflow-panel-1"
        },
        "error.type": {
          "type": "string",
          "required": true,
          "description": "Type of error that occurred",
          "placeholder": "CANVAS_NOT_FOUND"
        },
        "error.message": {
          "type": "string",
          "required": true,
          "description": "Human-readable error message",
          "placeholder": "Canvas file not found"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "scenario-selected",
      "type": "otel-event",
      "x": 0,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#8b5cf6",
      "label": "Scenario Selected",
      "event": {
        "name": "scenario.selected",
        "attributes": {
          "scenario.id": "string",
          "scenario.name": "string",
          "workflow.id": "string"
        }
      },
      "dataSchema": {
        "scenario.id": {
          "type": "string",
          "required": true,
          "description": "ID of the selected scenario",
          "placeholder": "static-render"
        },
        "scenario.name": {
          "type": "string",
          "required": false,
          "description": "Display name of the scenario",
          "placeholder": "Static Render"
        },
        "workflow.id": {
          "type": "string",
          "required": true,
          "description": "ID of the parent workflow",
          "placeholder": "panel-lifecycle"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "scenario-hovered",
      "type": "otel-event",
      "x": 960,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#a855f7",
      "label": "Scenario Hovered",
      "event": {
        "name": "scenario.hovered",
        "attributes": {
          "scenario.id": "string",
          "scenario.name": "string",
          "hover.state": "string"
        }
      },
      "dataSchema": {
        "scenario.id": {
          "type": "string",
          "required": true,
          "description": "ID of the hovered scenario",
          "placeholder": "static-render"
        },
        "scenario.name": {
          "type": "string",
          "required": false,
          "description": "Display name of the scenario",
          "placeholder": "Static Render"
        },
        "hover.state": {
          "type": "string",
          "required": true,
          "description": "enter or leave",
          "placeholder": "enter"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "trace-selected",
      "type": "otel-event",
      "x": 320,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#f59e0b",
      "label": "Trace Selected",
      "event": {
        "name": "trace.selected",
        "attributes": {
          "trace.id": "string",
          "trace.source": "string",
          "span.count": "number",
          "scenario.id": "string"
        }
      },
      "dataSchema": {
        "trace.id": {
          "type": "string",
          "required": true,
          "description": "ID of the selected trace",
          "placeholder": "trace-123"
        },
        "trace.source": {
          "type": "string",
          "required": true,
          "description": "Source of the trace data",
          "placeholder": "live"
        },
        "span.count": {
          "type": "number",
          "required": false,
          "description": "Number of spans in the trace",
          "placeholder": "5",
          "displayInLabel": false
        },
        "scenario.id": {
          "type": "string",
          "required": false,
          "description": "ID of the matched scenario",
          "placeholder": "static-render",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "trace-loaded",
      "type": "otel-event",
      "x": 640,
      "y": 160,
      "width": 280,
      "height": 120,
      "color": "#10b981",
      "label": "Trace Loaded",
      "event": {
        "name": "trace.loaded",
        "attributes": {
          "trace.id": "string",
          "span.count": "number",
          "event.count": "number",
          "match.type": "string",
          "coverage.percent": "number"
        }
      },
      "dataSchema": {
        "trace.id": {
          "type": "string",
          "required": true,
          "description": "ID of the loaded trace",
          "placeholder": "trace-123",
          "displayInLabel": false
        },
        "span.count": {
          "type": "number",
          "required": true,
          "description": "Number of spans in the trace",
          "placeholder": "5"
        },
        "event.count": {
          "type": "number",
          "required": true,
          "description": "Number of events in the trace",
          "placeholder": "12"
        },
        "match.type": {
          "type": "string",
          "required": false,
          "description": "Type of scenario match: full, partial, none",
          "placeholder": "full",
          "displayInLabel": false
        },
        "coverage.percent": {
          "type": "number",
          "required": false,
          "description": "Percentage of workflow covered by trace",
          "placeholder": "85",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "node-clicked",
      "type": "otel-event",
      "x": 0,
      "y": 320,
      "width": 280,
      "height": 120,
      "color": "#ec4899",
      "label": "Node Clicked",
      "event": {
        "name": "node.clicked",
        "attributes": {
          "node.id": "string",
          "node.event": "string",
          "modifier.shift": "boolean"
        }
      },
      "dataSchema": {
        "node.id": {
          "type": "string",
          "required": true,
          "description": "ID of the clicked node",
          "placeholder": "panel-loading"
        },
        "node.event": {
          "type": "string",
          "required": false,
          "description": "Event name associated with the node",
          "placeholder": "panel.loading",
          "displayInLabel": false
        },
        "modifier.shift": {
          "type": "boolean",
          "required": false,
          "description": "Whether shift key was held",
          "placeholder": "false",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "event-clicked",
      "type": "otel-event",
      "x": 320,
      "y": 320,
      "width": 280,
      "height": 120,
      "color": "#ec4899",
      "label": "Event Clicked",
      "event": {
        "name": "event.clicked",
        "attributes": {
          "event.name": "string",
          "event.index": "number",
          "span.index": "number"
        }
      },
      "dataSchema": {
        "event.name": {
          "type": "string",
          "required": true,
          "description": "Name of the clicked event",
          "placeholder": "panel.loading"
        },
        "event.index": {
          "type": "number",
          "required": true,
          "description": "Index of the event in the timeline",
          "placeholder": "0"
        },
        "span.index": {
          "type": "number",
          "required": false,
          "description": "Index of the parent span",
          "placeholder": "0",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "source-opened",
      "type": "otel-event",
      "x": 640,
      "y": 320,
      "width": 280,
      "height": 120,
      "color": "#06b6d4",
      "label": "Source Opened",
      "event": {
        "name": "source.opened",
        "attributes": {
          "source.path": "string",
          "trigger": "string"
        }
      },
      "dataSchema": {
        "source.path": {
          "type": "string",
          "required": true,
          "description": "Path to the source file",
          "placeholder": "src/panels/WorkflowScenariosPanel.tsx"
        },
        "trigger": {
          "type": "string",
          "required": false,
          "description": "What triggered opening: node-click, context-menu",
          "placeholder": "node-click"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "playback-started",
      "type": "otel-event",
      "x": 0,
      "y": 480,
      "width": 280,
      "height": 120,
      "color": "#84cc16",
      "label": "Playback Started",
      "event": {
        "name": "playback.started",
        "attributes": {
          "trace.id": "string",
          "span.index": "number",
          "event.index": "number"
        }
      },
      "dataSchema": {
        "trace.id": {
          "type": "string",
          "required": true,
          "description": "ID of the trace being played",
          "placeholder": "trace-123",
          "displayInLabel": false
        },
        "span.index": {
          "type": "number",
          "required": true,
          "description": "Starting span index",
          "placeholder": "0"
        },
        "event.index": {
          "type": "number",
          "required": true,
          "description": "Starting event index",
          "placeholder": "0",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "playback-stopped",
      "type": "otel-event",
      "x": 320,
      "y": 480,
      "width": 280,
      "height": 120,
      "color": "#64748b",
      "label": "Playback Stopped",
      "event": {
        "name": "playback.stopped",
        "attributes": {
          "trace.id": "string",
          "reason": "string",
          "span.index": "number",
          "event.index": "number"
        }
      },
      "dataSchema": {
        "trace.id": {
          "type": "string",
          "required": true,
          "description": "ID of the trace",
          "placeholder": "trace-123",
          "displayInLabel": false
        },
        "reason": {
          "type": "string",
          "required": true,
          "description": "Why playback stopped: completed, paused, error",
          "placeholder": "completed"
        },
        "span.index": {
          "type": "number",
          "required": true,
          "description": "Final span index",
          "placeholder": "4",
          "displayInLabel": false
        },
        "event.index": {
          "type": "number",
          "required": true,
          "description": "Final event index",
          "placeholder": "11",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "view-mode-changed",
      "type": "otel-event",
      "x": 640,
      "y": 480,
      "width": 280,
      "height": 120,
      "color": "#8b5cf6",
      "label": "View Mode Changed",
      "event": {
        "name": "view.mode.changed",
        "attributes": {
          "mode.previous": "string",
          "mode.current": "string"
        }
      },
      "dataSchema": {
        "mode.previous": {
          "type": "string",
          "required": true,
          "description": "Previous view mode",
          "placeholder": "canvas"
        },
        "mode.current": {
          "type": "string",
          "required": true,
          "description": "New view mode",
          "placeholder": "timeline"
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "canvas-focus-changed",
      "type": "otel-event",
      "x": 0,
      "y": 640,
      "width": 280,
      "height": 120,
      "color": "#0ea5e9",
      "label": "Canvas Focus Changed",
      "event": {
        "name": "canvas.focus.changed",
        "attributes": {
          "focus.source": "string",
          "focus.node.count": "number",
          "focus.event.names": "string[]"
        }
      },
      "dataSchema": {
        "focus.source": {
          "type": "string",
          "required": true,
          "description": "What triggered the focus change: scenario-selected, scenario-hovered, trace-loaded, execution-hovered",
          "placeholder": "scenario-selected",
          "displayInLabel": false
        },
        "focus.node.count": {
          "type": "number",
          "required": true,
          "description": "Number of nodes now focused",
          "placeholder": "5"
        },
        "focus.event.names": {
          "type": "array",
          "required": false,
          "description": "Event names that are now focused",
          "placeholder": "[\"panel.loading\", \"panel.loaded\"]",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "viewport-fitted",
      "type": "otel-event",
      "x": 320,
      "y": 640,
      "width": 280,
      "height": 120,
      "color": "#0ea5e9",
      "label": "Viewport Fitted",
      "event": {
        "name": "viewport.fitted",
        "attributes": {
          "fit.node.count": "number",
          "fit.padding": "number",
          "fit.trigger": "string"
        }
      },
      "dataSchema": {
        "fit.node.count": {
          "type": "number",
          "required": true,
          "description": "Number of nodes being fitted",
          "placeholder": "5",
          "displayInLabel": false
        },
        "fit.padding": {
          "type": "number",
          "required": false,
          "description": "Padding percentage used for fit (e.g., 0.15)",
          "placeholder": "0.15",
          "displayInLabel": false
        },
        "fit.trigger": {
          "type": "string",
          "required": true,
          "description": "What triggered the fit: scenario-selected, trace-loaded",
          "placeholder": "scenario-selected",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "node-highlighted",
      "type": "otel-event",
      "x": 640,
      "y": 640,
      "width": 280,
      "height": 120,
      "color": "#0ea5e9",
      "label": "Node Highlighted",
      "event": {
        "name": "node.highlighted",
        "attributes": {
          "node.id": "string",
          "node.event": "string",
          "highlight.source": "string"
        }
      },
      "dataSchema": {
        "node.id": {
          "type": "string",
          "required": true,
          "description": "ID of the highlighted node",
          "placeholder": "panel-loading"
        },
        "node.event": {
          "type": "string",
          "required": false,
          "description": "The event name associated with the highlighted node",
          "placeholder": "panel.loading"
        },
        "highlight.source": {
          "type": "string",
          "required": true,
          "description": "What triggered the highlight: node-clicked, event-clicked, playback",
          "placeholder": "node-clicked",
          "displayInLabel": false
        }
      },
      "otel": {
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-loading-loaded",
      "fromNode": "panel-loading",
      "toNode": "panel-loaded",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-loading-error",
      "fromNode": "panel-loading",
      "toNode": "panel-error",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-loaded-scenario",
      "fromNode": "panel-loaded",
      "toNode": "scenario-selected",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-scenario-trace",
      "fromNode": "scenario-selected",
      "toNode": "trace-selected",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-trace-loaded",
      "fromNode": "trace-selected",
      "toNode": "trace-loaded",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-trace-playback",
      "fromNode": "trace-loaded",
      "toNode": "playback-started",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-playback-stop",
      "fromNode": "playback-started",
      "toNode": "playback-stopped",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "edge-loaded-node-click",
      "fromNode": "panel-loaded",
      "toNode": "node-clicked",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-node-source",
      "fromNode": "node-clicked",
      "toNode": "source-opened",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-loaded-event-click",
      "fromNode": "trace-loaded",
      "toNode": "event-clicked",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-loaded-view-mode",
      "fromNode": "trace-loaded",
      "toNode": "view-mode-changed",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "emits"
      }
    },
    {
      "id": "edge-scenario-focus",
      "fromNode": "scenario-selected",
      "toNode": "canvas-focus-changed",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-scenario-hover-focus",
      "fromNode": "scenario-hovered",
      "toNode": "canvas-focus-changed",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-trace-focus",
      "fromNode": "trace-loaded",
      "toNode": "canvas-focus-changed",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-focus-viewport",
      "fromNode": "canvas-focus-changed",
      "toNode": "viewport-fitted",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-node-click-highlight",
      "fromNode": "node-clicked",
      "toNode": "node-highlighted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-node-click-viewport",
      "fromNode": "node-clicked",
      "toNode": "viewport-fitted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "triggers"
      }
    },
    {
      "id": "edge-event-click-highlight",
      "fromNode": "event-clicked",
      "toNode": "node-highlighted",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "triggers"
      }
    }
  ],
  "pv": {
    "name": "Workflow Scenarios Panel",
    "version": "1.0.0",
    "description": "OTEL event schema for the WorkflowScenariosPanel component",
    "markdown": ".principal-views/workflow-scenarios-panel/workflow-scenarios-panel.md"
  }
